<?xml version="1.0"?>
<package format="3">
  <name>pick_and_place</name>
  <version>1.0.0</version>
  <description>Pick and place controller using mc_rtc and ROS 2</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- launch files run impedance_control's wrench-aware bridge
       (kortex_mc_rtc_bridge_impedance) instead of this package's own
       non-wrench-aware kortex_mc_rtc_bridge, so ComplianceCartesianMove has
       a real measuredWrench() to react to -->
  <exec_depend>impedance_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
